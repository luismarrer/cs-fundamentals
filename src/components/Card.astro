---
interface Props {
  href: string;
  num: string;
  title: string;
  external?: boolean;
  ext?: string;
}

const { href, num, title, external = false, ext } = Astro.props;
const externalAttrs = external ? { target: '_blank', rel: 'noopener' } : {};
---

<a
  class:list={['course-card', { 'external-card': external }]}
  href={href}
  {...externalAttrs}
>
  <span class="card-topline">
    <span class="card-index">{num}</span>
    <span class="card-trace" aria-hidden="true"></span>
    <span class="card-arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
  </span>
  <h3>{title}</h3>
  <p><slot /></p>
  <span class="card-cta">{ext ?? (external ? 'Abrir proyecto' : 'Abrir capítulo')}</span>
</a>

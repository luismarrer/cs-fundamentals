---
import BaseLayout from './BaseLayout.astro';

interface PagerLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  kicker: string;
  heading: string;
  prev?: PagerLink;
  next?: PagerLink;
}

const { title, description, kicker, heading, prev, next } = Astro.props;
const chapterNumber = Number(kicker.match(/\d+/)?.[0] ?? 1);
const chapterLabel = String(chapterNumber).padStart(2, '0');
const chapterProgress = `${Math.round((chapterNumber / 5) * 100)}%`;
---

<BaseLayout title={title} description={description}>
  <main class="chapter-shell">
    <header class="chapter-hero">
      <div class="chapter-index" style={`--chapter-progress: ${chapterProgress}`}>
        <strong>{chapterLabel}</strong>
        <i aria-hidden="true"></i>
        <span>05</span>
      </div>
      <div>
        <p class="chapter-kicker">{kicker} · Ruta de construcción</p>
        <h1>{heading}</h1>
        <p class="chapter-route">Silicio → lógica → aritmética → memoria → programa</p>
      </div>
    </header>

    <article class="chapter">
      <slot />

      <nav class="chapter-pager" aria-label="Navegación entre capítulos">
        {
          prev ? (
            <a href={prev.href}>
              <span>Anterior</span>
              <strong>← {prev.label}</strong>
            </a>
          ) : (
            <span aria-hidden="true"></span>
          )
        }
        {
          next ? (
            <a href={next.href}>
              <span>Siguiente</span>
              <strong>{next.label} →</strong>
            </a>
          ) : (
            <span aria-hidden="true"></span>
          )
        }
      </nav>
    </article>
  </main>
</BaseLayout>

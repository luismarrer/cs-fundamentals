---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const isCpuChapter = Astro.url.pathname.replace(/\/$/, '') === '/capitulos/05-la-cpu';
const openDieMark = {
  package: 'M5 4H31V12H26V10H10V26H26V24H31V32H5Z',
  core: 'M21 14H29V22H21Z',
};
const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 36"><style>path{fill:#3159d8}@media(prefers-color-scheme:dark){path{fill:#a3b8ff}}</style><path d="${openDieMark.package}"/><path d="${openDieMark.core}"/></svg>`;
const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101922" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f1f4f7" media="(prefers-color-scheme: light)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href={faviconHref}
    />
  </head>
  <body class="bg-bg font-sans leading-relaxed text-ink antialiased">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href="/" aria-label="CPU abierta, página principal">
          <span class="brand-chip" aria-hidden="true">
            <svg data-open-die-mark viewBox="0 0 36 36">
              <path d={openDieMark.package} fill="currentColor"></path>
              <path d={openDieMark.core} fill="currentColor"></path>
            </svg>
          </span>
          <span class="site-brand-copy">
            <strong>CPU abierta</strong>
            <small>Fundamentos de computación</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="Navegación principal">
          <a href="/#explorar">Explorar</a>
          <a href="/#recorrido">Recorrido</a>
          <a href="/#proyectos">Proyectos</a>
        </nav>
        <a class="header-simulator" href="/capitulos/05-la-cpu" aria-label="Abrir Simulador CPU" aria-current={isCpuChapter ? 'page' : undefined}>
          <span class="simulator-index" aria-hidden="true">05</span>
          <span class="simulator-label-full" aria-hidden="true">Simulador CPU</span>
          <span class="simulator-label-mobile" aria-hidden="true">Simulador</span>
        </a>
      </div>
    </header>

    <div id="contenido" tabindex="-1"><slot /></div>

    <footer class="site-footer">
      <div>
        <strong>CPU abierta</strong>
        <p>Del transistor a la instrucción, explicado pieza por pieza.</p>
      </div>
      <nav class="footer-links" aria-label="Enlaces del proyecto">
        <a href="/#recorrido">Curso</a>
        <a href="https://github.com/luismarrer" target="_blank" rel="noopener">Luis Marrero ↗</a>
        <a href="https://github.com/luismarrer/cs-fundamentals" target="_blank" rel="noopener">Código fuente ↗</a>
      </nav>
    </footer>
  </body>
</html>
